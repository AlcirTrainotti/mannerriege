---
import Layout from '../layouts/Layout.astro'
import NavBar from '../components/NavBar.astro'
import SiteFooter from '../components/SiteFooter.astro'
import CtaButton from '../components/CtaButton.astro'
import SectionTag from '../components/SectionTag.astro'
import StatBlock from '../components/StatBlock.astro'
import Icon from '../components/Icon.astro'

import heroImg from '../assets/img/hero-time.jpg'
import convivioImg from '../assets/img/clube-convivio.jpg'
import baseImg from '../assets/img/projeto-2025-time.jpg'

const foundedYear = 1949
const anos = new Date().getFullYear() - foundedYear

const valores = [
  'Tradição', 'Respeito', 'Disciplina', 'Compromisso', 'Espírito coletivo',
  'Transparência', 'Inclusão', 'Formação humana', 'Responsabilidade social', 'Amor pelo voleibol',
]

const conquistas = [
  { titulo: 'Vice-Campeão Geral', comp: 'Campeonato Catarinense Master', ano: '2025' },
  { titulo: 'Campeão 55+', comp: 'Campeonato Catarinense Master', ano: '2025' },
  { titulo: 'Campeão 55+', comp: 'Superliga Master', ano: '2025' },
  { titulo: 'Campeão 55+', comp: 'Campeonato Brasileiro — Santos', ano: '2025' },
  { titulo: 'Campeão Geral', comp: 'Campeonato Catarinense Master', ano: '2024' },
  { titulo: 'Campeão 35+', comp: 'Campeonato Catarinense Master', ano: '2024' },
  { titulo: 'Vice-Campeão', comp: 'Campeonato Brasileiro Santos 50+', ano: '2024' },
  { titulo: 'Vice-Campeão', comp: 'Superliga Master 50+ (Pró-Kombat RJ)', ano: '2024' },
  { titulo: 'Campeão', comp: 'Serra Master Lages 40+', ano: '2024' },
  { titulo: 'Campeão', comp: 'Copa AABB Joinville 40+', ano: '2024' },
  { titulo: 'Campeões', comp: 'Superliga Master 40+ (parceria Corinthians SP)', ano: '2024' },
]
---
<Layout
  title="Mannerriege — Tradição joinvilense no voleibol nacional"
  description="Há 77 anos formando atletas e amizades no voleibol de Joinville. Conheça o Vôlei Master e o novo projeto social Vôlei de Base."
>
  <NavBar />

  <main>
    <!-- 3.1 HERO -->
    <section class="relative flex min-h-[96vh] items-end overflow-hidden bg-ink">
      <img
        src={heroImg.src ?? heroImg}
        alt="Equipe Mannerriege reunida na quadra com a bandeira do clube"
        class="absolute inset-0 h-full w-full object-cover object-[50%_30%]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink/60 via-transparent to-transparent"></div>

      <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-20 pt-40 sm:px-8">
        <p class="font-mono-label text-[11px] font-bold text-brand">
          Associação Desportiva de Voleibol &middot; Joinville/SC &middot; desde {foundedYear}
        </p>
        <h1 class="hero-kinetic mt-5 font-display text-[16vw] font-extrabold uppercase leading-none text-white sm:text-8xl lg:text-9xl">
          Mannerriege
        </h1>
        <p class="mt-3 max-w-2xl font-display text-2xl font-semibold text-white/90 sm:text-3xl">
          {anos} anos de tradição joinvilense no voleibol nacional
        </p>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-paper/75 sm:text-lg">
          Mais que um time: uma confraria que joga, compete e se encontra há décadas —
          e que agora abre a próxima página da sua história.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <CtaButton href="/associe-se" variant="primary" magnetic>Quero ser associado</CtaButton>
          <CtaButton href="/base" variant="outline-light" magnetic>Conheça o projeto de base</CtaButton>
        </div>
      </div>
    </section>

    <!-- 3.2 PLACAR DE CREDIBILIDADE -->
    <section class="bg-ink py-12">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-5 sm:grid-cols-4 sm:px-8">
        <StatBlock to={anos} suffix="" label="Anos de história" light />
        <StatBlock to={foundedYear} label="Ano de fundação" light />
        <StatBlock to={6} label="Categorias: 35+ a 60+" light />
        <StatBlock to={40} suffix="+" label="Associados voluntários" light />
      </div>
    </section>

    <!-- 3.3 QUEM SOMOS -->
    <section class="bg-paper py-24">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:items-center">
        <div class="reveal">
          <SectionTag text="Quem somos" />
          <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
            Mais que um time,<br />uma confraria.
          </h2>
          <p class="mt-5 leading-relaxed text-ink-soft">
            O Mannerriege é uma associação esportiva dedicada ao voleibol, à formação humana e à
            promoção do esporte como ferramenta de desenvolvimento social. Reunimos, há {anos} anos,
            pessoas de 35 a 60+ anos em torno da mesma paixão: jogar, competir e se encontrar.
          </p>
          <p class="mt-4 leading-relaxed text-ink-soft">
            Seis categorias competitivas, dezenas de associados voluntários e uma gestão que une
            tradição com governança séria — essa é a base sobre a qual construímos tudo o mais.
          </p>
          <div class="mt-7">
            <CtaButton href="/master" variant="outline-dark">Conheça o Vôlei Master</CtaButton>
          </div>
        </div>
        <div class="reveal relative" style="transition-delay: 120ms">
          <img src={convivioImg.src ?? convivioImg} alt="Associados do Mannerriege reunidos na sede do clube" class="w-full rounded-2xl object-cover shadow-lift" />
          <div class="absolute -bottom-6 -left-6 hidden rounded-2xl bg-white px-6 py-5 shadow-lift sm:block">
            <p class="font-display text-3xl font-extrabold text-brand">40+</p>
            <p class="font-mono-label text-[10px] font-bold text-ink-soft">Associados voluntários</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3.4 TRAJETORIA VITORIOSA — scroll horizontal de trofeus -->
    <section class="relative overflow-hidden bg-paper-dim py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-xl">
            <SectionTag text="História gloriosa" />
            <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
              Trajetória vitoriosa
            </h2>
            <p class="mt-3 leading-relaxed text-ink-soft">
              Em 2024, conquistamos o lugar mais alto do pódium Catarinense Master Geral. Em 2025,
              ganhamos o Brasil — com recursos financeiros internos dos próprios associados.
            </p>
          </div>
          <div class="hidden gap-2 sm:flex">
            <button class="js-trophy-prev flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Anterior">
              <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
            </button>
            <button class="js-trophy-next flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Próximo">
              <Icon name="arrow-right" class="h-4 w-4" />
            </button>
          </div>
        </div>
      </div>

      <div class="js-trophy-track trophy-track reveal mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:px-8" style="transition-delay: 100ms">
        {conquistas.map((c) => (
          <div class="flex w-[280px] flex-shrink-0 snap-start flex-col justify-between rounded-2xl bg-white p-7 shadow-card">
            <Icon name="trophy" class="h-8 w-8 text-gold" />
            <div class="mt-8">
              <p class="font-mono-label text-[10px] font-bold text-brand">{c.ano}</p>
              <p class="mt-2 font-display text-2xl font-bold text-ink">{c.titulo}</p>
              <p class="mt-1 text-sm leading-snug text-ink-soft">{c.comp}</p>
            </div>
          </div>
        ))}
        <a href="/historia" class="flex w-[280px] flex-shrink-0 snap-start flex-col items-start justify-center gap-3 rounded-2xl border border-dashed border-ink/20 p-7 text-ink-soft transition-colors hover:border-ink hover:text-ink">
          <Icon name="arrow-right" class="h-6 w-6" />
          <span class="font-mono-label text-[11px] font-bold">Ver histórico completo</span>
        </a>
      </div>
    </section>

    <!-- 3.5 PROPOSITO — missao, visao e valores -->
    <section class="bg-paper py-20">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal max-w-2xl">
          <SectionTag text="Propósito" />
          <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
            Missão, visão e valores
          </h2>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          <div class="reveal rounded-2xl bg-white p-8 shadow-card">
            <Icon name="shield" class="h-8 w-8 text-brand" />
            <h3 class="mt-5 font-display text-2xl font-bold text-ink">Missão</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">
              Oferecer lazer por meio do voleibol, promovendo disciplina, saúde, cidadania,
              convivência e oportunidades para a população de Joinville.
            </p>
          </div>
          <div class="reveal rounded-2xl bg-white p-8 shadow-card" style="transition-delay: 120ms">
            <Icon name="arrow-right" class="h-8 w-8 text-brand" />
            <h3 class="mt-5 font-display text-2xl font-bold text-ink">Visão</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">
              Ser referência no voleibol master, reconhecida pela tradição, seriedade, excelência
              esportiva, impacto social e compromisso com o desenvolvimento humano.
            </p>
          </div>
        </div>

        <div class="reveal mt-10 flex flex-wrap gap-2.5" style="transition-delay: 100ms">
          {valores.map((v) => (
            <span class="rounded-full border border-brand/25 bg-brand-soft px-4 py-2 font-mono-label text-[11px] font-bold text-brand-deep transition-transform hover:-translate-y-0.5">
              {v}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- 3.6 A VIRADA -->
    <section class="relative overflow-hidden bg-gold py-28">
      <div class="hatch-mark pointer-events-none absolute -right-20 -top-20 h-72 w-72 rotate-12 text-ink/10"></div>
      <div class="hatch-mark pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 -rotate-12 text-ink/10"></div>
      <div class="relative mx-auto max-w-4xl px-5 text-center sm:px-8">
        <span class="reveal inline-flex items-center gap-2 rounded-full bg-ink/10 px-4 py-1.5 font-mono-label text-[11px] font-bold text-ink">
          <Icon name="heart" class="h-3.5 w-3.5" /> A virada
        </span>
        <p class="reveal mt-7 font-display text-3xl font-extrabold leading-tight text-ink sm:text-5xl" style="transition-delay: 100ms">
          {anos} anos recebendo do voleibol.<br />Agora é hora de retribuir.
        </p>
        <p class="reveal mx-auto mt-6 max-w-xl leading-relaxed text-ink/90" style="transition-delay: 180ms">
          Toda a experiência acumulada dentro das quadras — títulos, gestão, comunidade —
          vira agora oportunidade para uma nova geração de atletas e cidadãos de Joinville.
        </p>
      </div>
    </section>

    <!-- 3.7 VOLEI DE BASE -->
    <section class="bg-ink py-24">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:items-center">
        <div class="reveal order-2 lg:order-1">
          <img src={baseImg.src ?? baseImg} alt="Atletas do projeto Vôlei de Base Mannerriege em quadra" class="w-full rounded-2xl object-cover shadow-lift" />
        </div>
        <div class="reveal order-1 lg:order-2" style="transition-delay: 120ms">
          <span class="inline-flex items-center gap-2 rounded-full bg-gold-soft px-4 py-1.5 font-mono-label text-[11px] font-bold text-gold">
            Festival de Abertura · Data a definir
          </span>
          <h2 class="mt-5 font-display text-4xl font-extrabold uppercase text-white sm:text-5xl">
            Mannerriege Vôlei de Base
          </h2>
          <p class="mt-2 font-display text-xl font-semibold text-brand sm:text-2xl">
            Formando atletas e cidadãos por meio do voleibol.
          </p>
          <p class="mt-5 leading-relaxed text-paper/70">
            Conduzimos o projeto com 40 atletas — Sub-13 e Sub-15, meninos e meninas — treinando
            na quadra da Sociedade Ginástica de Joinville, de segunda a quinta-feira, das 9h às
            10h30. Formação esportiva, liderada por quem já viveu o alto rendimento:
            Ricardo Perini de Aviz — ex-atleta profissional, com carreira sólida na Europa,
            formado nas categorias de base de Joinville — e Eduardo Perini de Aviz, bicampeão de
            Superliga, também formado na base joinvilense.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <CtaButton href="/base" variant="primary" magnetic>Conheça o projeto</CtaButton>
            <CtaButton href="/apoie" variant="outline-light" magnetic>Quero apoiar</CtaButton>
          </div>
        </div>
      </div>
    </section>

    <!-- 3.8 PROVA SOCIAL CRUZADA -->
    <section class="grid sm:grid-cols-2">
      <a href="/master" class="group relative flex min-h-[380px] items-end overflow-hidden bg-brand p-10">
        <div class="hatch-mark pointer-events-none absolute -right-10 -top-10 h-48 w-48 text-white/10"></div>
        <div class="relative">
          <p class="font-mono-label text-xs font-bold text-white/70 sm:text-sm">{anos} anos de história</p>
          <p class="mt-3 font-display text-5xl font-extrabold text-white sm:text-6xl">Vôlei Master</p>
          <p class="mt-3 flex items-center gap-2 font-mono-label text-xs font-bold text-white/80 transition-transform group-hover:translate-x-1 sm:text-sm">
            Conhecer <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </p>
        </div>
      </a>
      <a href="/base" class="group relative flex min-h-[380px] items-end overflow-hidden bg-navy p-10">
        <div class="hatch-mark pointer-events-none absolute -right-10 -top-10 h-48 w-48 text-white/10"></div>
        <div class="relative">
          <p class="font-mono-label text-xs font-bold text-white/70 sm:text-sm">O novo capítulo</p>
          <p class="mt-3 font-display text-5xl font-extrabold text-white sm:text-6xl">Vôlei de Base</p>
          <p class="mt-3 flex items-center gap-2 font-mono-label text-xs font-bold text-white/80 transition-transform group-hover:translate-x-1 sm:text-sm">
            Conhecer <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </p>
        </div>
      </a>
    </section>

    <!-- 3.9 CTA FINAL -->
    <section class="bg-brand py-20">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-5 sm:px-8 lg:flex-row lg:items-center">
        <div class="reveal max-w-xl">
          <h2 class="font-display text-3xl font-extrabold uppercase text-white sm:text-4xl">
            Faça parte da próxima página do Mannerriege
          </h2>
          <p class="mt-3 leading-relaxed text-white/85">
            Venha jogar com a gente, ou ajude a formar o futuro do voleibol joinvilense.
          </p>
        </div>
        <div class="reveal flex flex-shrink-0 flex-wrap gap-4" style="transition-delay: 100ms">
          <CtaButton href="/associe-se" variant="outline-light" magnetic>Quero ser associado</CtaButton>
          <CtaButton href="/apoie" variant="outline-light" magnetic>Ver cotas de patrocínio</CtaButton>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
