---
import Layout from '../../layouts/Layout.astro'
import NavBar from '../../components/NavBar.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import SectionTag from '../../components/SectionTag.astro'
import Icon from '../../components/Icon.astro'

import heroImg from '../../assets/img/clube-convivio.jpg'

const posicoes = ['Levantador(a)', 'Ponteiro(a)', 'Central / Meio de rede', 'Oposto(a)', 'Líbero', 'Outra / Não sei ainda']
---
<Layout
  title="Quero ser associado — Mannerriege"
  description="Faça parte do Vôlei Master do Mannerriege. Conte pra gente quem você é e como já jogou — a diretoria entra em contato pelo WhatsApp."
>
  <NavBar />

  <PageHero
    eyebrow="Vôlei Master · 35+"
    title="Quero ser associado"
    subtitle="Conta pra gente quem você é. Em pouco tempo alguém da diretoria fala com você pelo WhatsApp."
    image={heroImg}
  />

  <main>
    <section class="bg-paper py-24">
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <div class="reveal">
          <SectionTag text="Faça parte" />
          <h2 class="mt-4 font-display text-3xl font-extrabold text-ink sm:text-4xl">
            Cinco perguntas rápidas
          </h2>
          <p class="mt-3 leading-relaxed text-ink-soft">
            Sem burocracia: preencha os dados abaixo e a diretoria do Mannerriege entra em contato
            para conversar sobre categoria, treinos e próximos passos.
          </p>
        </div>

        <form id="form-associe-se" class="reveal mt-10 space-y-6" style="transition-delay: 100ms">
          <div>
            <label for="nome" class="font-mono-label text-[11px] font-bold text-ink-soft">Nome completo *</label>
            <input
              id="nome" name="nome" type="text" required
              class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
              placeholder="Seu nome completo"
            />
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="telefone" class="font-mono-label text-[11px] font-bold text-ink-soft">Telefone com WhatsApp *</label>
              <input
                id="telefone" name="telefone" type="tel" required
                class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
                placeholder="(47) 99999-9999"
              />
            </div>
            <div>
              <label for="dataNascimento" class="font-mono-label text-[11px] font-bold text-ink-soft">Data de nascimento *</label>
              <input
                id="dataNascimento" name="dataNascimento" type="date" required
                class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
              />
            </div>
          </div>

          <div>
            <label for="posicao" class="font-mono-label text-[11px] font-bold text-ink-soft">Posição que joga *</label>
            <select
              id="posicao" name="posicao" required
              class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
            >
              <option value="" disabled selected>Selecione</option>
              {posicoes.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>

          <div>
            <label for="relato" class="font-mono-label text-[11px] font-bold text-ink-soft">Onde você já jogou? *</label>
            <textarea
              id="relato" name="relato" required rows="4"
              class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
              placeholder="Conte um pouco da sua trajetória: clube, time de bairro, faculdade, quanto tempo parado, o que procura hoje..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="js-submit-btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand px-6 py-4 font-mono-label text-[11px] font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-brand-deep disabled:opacity-60 sm:w-auto"
          >
            <span class="js-submit-label">Enviar e falar com a diretoria</span>
            <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </button>

          <p class="js-form-error hidden text-sm font-medium text-brand-deep"></p>
        </form>

        <div id="form-sucesso" class="reveal hidden rounded-2xl bg-white p-10 text-center shadow-card">
          <Icon name="check" class="mx-auto h-10 w-10 text-brand" />
          <h3 class="mt-4 font-display text-2xl font-bold text-ink">Recebemos seus dados!</h3>
          <p class="mt-2 leading-relaxed text-ink-soft">
            Obrigado por querer fazer parte do Mannerriege. A diretoria vai entrar em contato pelo
            WhatsApp em breve.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseAnonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
    const form = document.getElementById('form-associe-se')
    const sucesso = document.getElementById('form-sucesso')

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const btn = form.querySelector('.js-submit-btn')
      const label = form.querySelector('.js-submit-label')
      const errorEl = form.querySelector('.js-form-error')
      errorEl.classList.add('hidden')

      const data = Object.fromEntries(new FormData(form).entries())

      btn.disabled = true
      label.textContent = 'Enviando...'

      try {
        const res = await fetch(`${supabaseUrl}/functions/v1/interesse-associado`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: supabaseAnonKey,
            Authorization: `Bearer ${supabaseAnonKey}`,
          },
          body: JSON.stringify(data),
        })

        if (!res.ok) {
          const body = await res.json().catch(() => ({}))
          throw new Error(body.error || 'Não foi possível enviar agora. Tente novamente.')
        }

        form.classList.add('hidden')
        sucesso?.classList.remove('hidden')
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : 'Erro inesperado. Tente novamente.'
        errorEl.classList.remove('hidden')
        btn.disabled = false
        label.textContent = 'Enviar e falar com a diretoria'
      }
    })
  </script>
</Layout>
