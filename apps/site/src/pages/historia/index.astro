---
import Layout from '../../layouts/Layout.astro'
import NavBar from '../../components/NavBar.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import SectionTag from '../../components/SectionTag.astro'
import CtaButton from '../../components/CtaButton.astro'
import Icon from '../../components/Icon.astro'

import historiaImg from '../../assets/img/historia-50anos.jpg'

const foundedYear = 1949
const anos = new Date().getFullYear() - foundedYear

const linhaDoTempo = [
  {
    ano: '1949',
    titulo: 'Fundação do Mannerriege',
    texto: 'Nasce a Associação Desportiva de Voleibol, ligada à Sociedade Ginástica de Joinville (SGJ), reunindo os primeiros apaixonados pelo voleibol joinvilense.',
  },
  {
    ano: '2024',
    titulo: 'Campeão Geral — Catarinense Master',
    texto: 'Pela primeira vez, conquistamos o lugar mais alto do pódium do Campeonato Catarinense Master Geral — com recursos financeiros internos dos próprios associados.',
  },
  {
    ano: '2025',
    titulo: 'CNPJ formalizado',
    texto: 'A associação formaliza seu CNPJ, estruturando a governança para os próximos capítulos do clube.',
  },
  {
    ano: '2025',
    titulo: 'Campeão Brasileiro 55+',
    texto: 'Conquistamos o título nacional em Santos, além do bicampeonato 55+ no Catarinense e na Superliga Master — o ano em que "ganhamos o Brasil".',
  },
  {
    ano: '2026',
    titulo: 'Nova diretoria, novo momento',
    texto: 'Eduardo Perini de Aviz assume a presidência e Ricardo Perini de Aviz a vice-presidência e coordenação do Vôlei de Base — dois ex-atletas que voltam para investir na base.',
  },
  {
    ano: '2026',
    titulo: 'Nasce o Vôlei de Base',
    texto: 'O Mannerriege lança seu projeto social: formação esportiva gratuita para crianças e adolescentes de Joinville, com o Festival de Abertura marcando o início desta nova fase.',
  },
]
---
<Layout
  title="Nossa História — Mannerriege"
  description="77 anos de tradição joinvilense no voleibol: da fundação em 1949 aos títulos nacionais de 2025 e ao novo capítulo do Vôlei de Base."
>
  <NavBar />

  <PageHero
    eyebrow={`Desde ${foundedYear}`}
    title="Nossa história"
    subtitle="Uma tradição do voleibol joinvilense, construída por gerações de atletas, associados e famílias."
    image={historiaImg}
  />

  <main>
    <!-- INTRO -->
    <section class="bg-paper py-24">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
        <SectionTag text="Tradição joinvilense" />
        <p class="reveal mt-6 text-lg leading-relaxed text-ink-soft">
          O Mannerriege é a mais antiga agremiação de voleibol master do Brasil. Ao longo de{' '}
          {anos} anos, carrega uma trajetória construída por atletas, associados, famílias e
          apaixonados pelo voleibol — mais do que uma equipe, uma cultura esportiva baseada em
          amizade, disciplina, dedicação e respeito à história da modalidade em Joinville.
        </p>
        <p class="reveal mt-4 leading-relaxed text-ink-soft" style="transition-delay: 100ms">
          Essa tradição agora se conecta a uma nova fase: transformar a experiência acumulada
          dentro das quadras em oportunidade para jovens atletas. O projeto Mannerriege Vôlei de
          Base nasce justamente desse encontro entre passado, presente e futuro.
        </p>
      </div>
    </section>

    <!-- AMIZADE, SAUDE E LAZER -->
    <section class="bg-brand py-16">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
        <p class="reveal text-lg leading-relaxed text-white/95">
          Há {anos} anos unimos gerações para a prática do voleibol e do dominó em prol da
          amizade, saúde e lazer para ex-atletas. Contamos com mais de 40 associados que
          voluntariamente constroem essa história, com muita dedicação e recursos próprios,
          distribuídos nas categorias 35+, 40+, 45+, 50+, 55+ e 60+.
        </p>
      </div>
    </section>

    <!-- LINHA DO TEMPO — carrossel horizontal -->
    <section class="relative overflow-hidden bg-paper-dim py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-xl">
            <SectionTag text="Linha do tempo" />
            <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
              {anos} anos, marco a marco
            </h2>
            <p class="mt-3 leading-relaxed text-ink-soft">
              Estes são os marcos que já temos documentados. Entre a fundação em 1949 e os títulos
              recentes há décadas de história que ainda estamos resgatando — a linha do tempo
              cresce conforme o levantamento avança.
            </p>
          </div>
          <div class="hidden gap-2 sm:flex">
            <button class="js-trophy-prev flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Marco anterior">
              <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
            </button>
            <button class="js-trophy-next flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Próximo marco">
              <Icon name="arrow-right" class="h-4 w-4" />
            </button>
          </div>
        </div>
      </div>

      <div class="js-trophy-track trophy-track reveal mt-14 flex snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-6 sm:px-8" style="transition-delay: 100ms">
        {linhaDoTempo.map((item, i) => (
          <div class="group flex w-[300px] flex-shrink-0 snap-start flex-col sm:w-[340px]">
            <!-- trilho horizontal com marcador -->
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 flex-shrink-0 rounded-full bg-brand transition-transform duration-300 group-hover:scale-125"></span>
              <span class="h-0.5 w-full bg-brand/20"></span>
            </div>
            <div class="mt-6 flex-1 rounded-2xl bg-white p-7 shadow-card transition-all duration-300 group-hover:-translate-y-1.5 group-hover:shadow-lift">
              <p class="font-display text-3xl font-extrabold text-brand">{item.ano}</p>
              <h3 class="mt-3 font-display text-xl font-bold text-ink">{item.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.texto}</p>
            </div>
          </div>
        ))}
        <div class="flex w-[240px] flex-shrink-0 snap-start flex-col">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 flex-shrink-0 rounded-full border-2 border-dashed border-brand/50 bg-paper-dim"></span>
            <span class="h-0.5 w-full bg-brand/10"></span>
          </div>
          <div class="mt-6 flex flex-1 flex-col justify-center gap-2 rounded-2xl border border-dashed border-ink/20 p-7 text-ink-soft">
            <Icon name="arrow-right" class="h-5 w-5" />
            <span class="font-mono-label text-[11px] font-bold">Décadas em catalogação — a linha vai crescer aqui</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CITACAO -->
    <section class="bg-ink py-20">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
        <p class="reveal font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
          "Nossa história nos trouxe até aqui.<br />Nosso compromisso com a base vai nos levar
          adiante."
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-paper py-20">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:px-8 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="reveal font-display text-3xl font-extrabold text-ink sm:text-4xl">
          Conheça o capítulo que estamos escrevendo agora
        </h2>
        <div class="reveal flex flex-shrink-0 flex-wrap gap-4" style="transition-delay: 100ms">
          <CtaButton href="/master" variant="outline-dark">Ver conquistas <Icon name="arrow-right" class="h-3.5 w-3.5" /></CtaButton>
          <CtaButton href="/base" variant="primary">Vôlei de Base <Icon name="arrow-right" class="h-3.5 w-3.5" /></CtaButton>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
