---
import Layout from '../../layouts/Layout.astro'
import NavBar from '../../components/NavBar.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import SectionTag from '../../components/SectionTag.astro'
import CtaButton from '../../components/CtaButton.astro'
import Icon from '../../components/Icon.astro'

import heroImg from '../../assets/img/master-conquista-2025.jpg'
import convivioImg from '../../assets/img/clube-convivio.jpg'

const foundedYear = 1949
const anos = new Date().getFullYear() - foundedYear
const categorias = ['35+', '40+', '45+', '50+', '55+', '60+']

const temporadas = [
  {
    ano: '2025',
    titulos: [
      'Vice-Campeão Geral — Campeonato Catarinense Master',
      'Campeão 55+ — Campeonato Catarinense Master',
      'Campeão 55+ — Superliga Master',
      'Campeão 55+ — Campeonato Brasileiro (Santos)',
    ],
  },
  {
    ano: '2024',
    titulos: [
      'Campeão Geral — Campeonato Catarinense Master',
      'Campeão 35+ — Campeonato Catarinense Master',
      'Vice-Campeão 40+ — Campeonato Catarinense Master',
      '5º lugar 45+ — Campeonato Catarinense Master',
      'Vice-Campeão 50+ — Campeonato Catarinense Master',
      'Vice-Campeão 55+ — Campeonato Catarinense Master',
      'Vice-Campeão — Campeonato Brasileiro Santos 50+',
      'Vice-Campeão — Superliga Master 50+ (Pró-Kombat RJ)',
      'Campeões — Superliga Master 40+ (Corinthians SP)',
      'Campeão — Serra Master Lages 40+',
      'Campeão — Copa AABB Joinville 40+',
      '6º lugar — Superliga Master 55+',
    ],
  },
  // Próximas temporadas (2023 e anteriores) entram aqui assim que o
  // levantamento histórico for concluído — ver nota na seção de conquistas.
]
const totalTitulos = temporadas.reduce((acc, t) => acc + t.titulos.length, 0)
---
<Layout
  title="Vôlei Master — Mannerriege"
  description="Seis categorias competitivas, mais de 40 associados voluntários e décadas de tradição joinvilense no voleibol master nacional."
>
  <NavBar />

  <PageHero
    eyebrow={`Frente esportiva · desde ${foundedYear}`}
    title="Vôlei Master"
    subtitle={`Seis categorias competitivas, ${anos} anos de história e uma confraria que joga, compete e se encontra há décadas.`}
    image={heroImg}
  />

  <main>
    <!-- QUEM SOMOS -->
    <section class="bg-paper py-24">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:items-center">
        <div class="reveal">
          <SectionTag text="Quem somos" />
          <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
            Mais que um time,<br />uma confraria.
          </h2>
          <p class="mt-5 leading-relaxed text-ink-soft">
            O Vôlei Master é a frente esportiva mais consolidada do Mannerriege: pessoas de 35 a
            60+ anos que jogam, competem e se encontram em torno da mesma paixão pelo voleibol.
            Reunimos, há {anos} anos, dezenas de associados voluntários que sustentam essa história
            com dedicação e recursos próprios.
          </p>
          <p class="mt-4 leading-relaxed text-ink-soft">
            Mais do que competição, o Master é convivência: amizade, disciplina e o espírito
            coletivo que atravessa gerações de atletas joinvilenses.
          </p>
          <div class="mt-7 flex flex-wrap gap-4">
            <CtaButton href="/associe-se" variant="primary">Quero ser associado</CtaButton>
            <CtaButton href="/historia" variant="outline-dark">Ver história completa</CtaButton>
          </div>
        </div>
        <div class="reveal relative" style="transition-delay: 120ms">
          <img src={convivioImg.src ?? convivioImg} alt="Associados do Mannerriege reunidos na sede do clube" class="w-full rounded-2xl object-cover shadow-lift" />
        </div>
      </div>
    </section>

    <!-- CATEGORIAS -->
    <section class="bg-paper-dim py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal max-w-2xl">
          <SectionTag text="Onde competimos" />
          <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
            Seis categorias
          </h2>
          <p class="mt-3 leading-relaxed text-ink-soft">
            O Mannerriege coloca equipes em quadra em todas as categorias do voleibol master —
            da estreia aos 35+ até a veterania dos 60+.
          </p>
        </div>
        <div class="mt-10 grid grid-cols-3 gap-4 sm:grid-cols-6">
          {categorias.map((c, i) => (
            <div
              class="reveal group rounded-2xl border border-ink/8 bg-white p-6 text-center shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift"
              style={`transition-delay: ${i * 60}ms`}
            >
              <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-soft text-brand-deep transition-colors group-hover:bg-brand group-hover:text-white">
                <Icon name="volleyball" class="h-4.5 w-4.5" />
              </div>
              <p class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">{c}</p>
              <p class="mt-1 font-mono-label text-[10px] font-bold text-ink-soft">Categoria</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONQUISTAS — carrossel, mesmo padrao da Home -->
    <section class="relative overflow-hidden bg-paper-dim py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-xl">
            <SectionTag text="História gloriosa" />
            <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
              Conquistas recentes
            </h2>
            <p class="mt-3 leading-relaxed text-ink-soft">
              Em 2024, conquistamos o lugar mais alto do pódium Catarinense Master Geral. Em 2025,
              ganhamos o Brasil — com recursos financeiros internos dos próprios associados. Navegue
              pelo carrossel: {totalTitulos} títulos catalogados até aqui, temporada por temporada.
              Os {anos} anos de história do Mannerriege somam muito mais resultado do que isso — as
              temporadas mais antigas entram aqui conforme o resgate histórico avança.
            </p>
          </div>
          <div class="hidden gap-2 sm:flex">
            <button class="js-trophy-prev flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Anterior">
              <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
            </button>
            <button class="js-trophy-next flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Próximo">
              <Icon name="arrow-right" class="h-4 w-4" />
            </button>
          </div>
        </div>
      </div>

      <div class="js-trophy-track trophy-track reveal mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:px-8" style="transition-delay: 100ms">
        {temporadas.map((t) => (
          <div class="flex w-[320px] flex-shrink-0 snap-start flex-col rounded-2xl bg-white p-7 shadow-card sm:w-[360px]">
            <div class="flex items-baseline justify-between border-b border-ink/8 pb-4">
              <p class="font-display text-4xl font-extrabold text-ink">{t.ano}</p>
              <p class="font-mono-label text-[10px] font-bold text-ink-soft">{t.titulos.length} título{t.titulos.length > 1 ? 's' : ''}</p>
            </div>
            <ul class="mt-4 space-y-3">
              {t.titulos.map((titulo) => (
                <li class="flex items-start gap-2.5 text-sm leading-snug text-ink">
                  <Icon name="trophy" class="mt-0.5 h-4 w-4 flex-shrink-0 text-gold" />
                  {titulo}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div class="flex w-[220px] flex-shrink-0 snap-start flex-col items-start justify-center gap-2 rounded-2xl border border-dashed border-ink/20 p-7 text-ink-soft">
          <Icon name="trophy" class="h-6 w-6" />
          <span class="font-mono-label text-[11px] font-bold">Temporadas anteriores em catalogação</span>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="bg-brand py-20">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-5 sm:px-8 lg:flex-row lg:items-center">
        <div class="reveal max-w-xl">
          <h2 class="font-display text-3xl font-extrabold uppercase text-white sm:text-4xl">
            Venha jogar com a gente
          </h2>
          <p class="mt-3 leading-relaxed text-white/85">
            Se você tem 35 anos ou mais e quer voltar a jogar vôlei com seriedade e amizade, fale
            com a gente.
          </p>
        </div>
        <div class="reveal flex flex-shrink-0 flex-wrap gap-4" style="transition-delay: 100ms">
          <CtaButton href="/associe-se" variant="outline-light" magnetic>Quero ser associado</CtaButton>
          <CtaButton href="/contato" variant="outline-light" magnetic>Fale conosco</CtaButton>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
