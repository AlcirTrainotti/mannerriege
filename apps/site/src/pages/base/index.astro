---
import Layout from '../../layouts/Layout.astro'
import NavBar from '../../components/NavBar.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import SectionTag from '../../components/SectionTag.astro'
import CtaButton from '../../components/CtaButton.astro'
import Icon from '../../components/Icon.astro'

import baseImg from '../../assets/img/projeto-2025-time.jpg'
import ricardoImg from '../../assets/img/ricardo-perini.jpg'
import eduardoImg from '../../assets/img/eduardo-perini.jpg'

const foundedYear = 1949
const anos = new Date().getFullYear() - foundedYear

const fatos = [
  { icon: 'users', label: 'Atletas', valor: '40', detalhe: 'meninos e meninas' },
  { icon: 'volleyball', label: 'Categorias', valor: 'Sub-13 e Sub-15', detalhe: '12 a 15 anos' },
  { icon: 'pin', label: 'Local', valor: 'SGJ', detalhe: 'Sociedade Ginástica de Joinville' },
  { icon: 'calendar', label: 'Treinos', valor: 'Seg a Qui', detalhe: '9h às 10h30' },
]

const riscos = [
  { valor: '81%', texto: 'dos técnicos já identificaram sinais de burnout em jovens atletas sob sua responsabilidade.' },
  { valor: '72%', texto: 'dos estudantes-atletas relatam pressão excessiva — gatilho de abandono do esporte.' },
  { valor: '+465%', texto: 'nos atendimentos por ansiedade em crianças e adolescentes no Brasil entre 2015 e 2023.' },
  { valor: '70%+', texto: 'das crianças brasileiras não atingem o mínimo de atividade física recomendado pela OMS.' },
]

const cronograma = [
  { periodo: 'JUL – AGO', titulo: 'Estruturação', texto: 'Estruturação final do local, materiais e equipe técnica.' },
  { periodo: 'AGOSTO', titulo: 'Festival de Abertura', texto: 'Abertura oficial do Projeto Vôlei de Base, apresentando a proposta à comunidade.' },
  { periodo: 'AGO – DEZ', titulo: 'Operação', texto: 'Treinos regulares das turmas Sub-13 e Sub-15, com seleção técnica contínua.' },
  { periodo: 'DEZEMBRO', titulo: 'Fase 2', texto: 'Encerramento da Fase 1 e planejamento da Fase 2 do projeto.' },
]

const valores = ['Formação humana', 'Disciplina', 'Respeito', 'Espírito coletivo', 'Inclusão', 'Responsabilidade social']
---
<Layout
  title="Vôlei de Base — Mannerriege"
  description="Formação esportiva de base para crianças e adolescentes de Joinville. Sub-13 e Sub-15, na Sociedade Ginástica de Joinville, liderado por Ricardo e Eduardo Perini de Aviz."
>
  <NavBar />

  <PageHero
    eyebrow="Projeto social · Mannerriege"
    title="Vôlei de Base"
    subtitle={`${anos} anos de tradição joinvillense abrem um novo capítulo: formar a próxima geração do voleibol catarinense.`}
    image={baseImg}
  />

  <main>
    <!-- PONTO DE PARTIDA -->
    <section class="relative overflow-hidden bg-gold py-20">
      <div class="hatch-mark pointer-events-none absolute -right-20 -top-20 h-72 w-72 rotate-12 text-ink/10"></div>
      <div class="hatch-mark pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 -rotate-12 text-ink/10"></div>
      <div class="relative mx-auto max-w-3xl px-5 text-center sm:px-8">
        <span class="reveal inline-flex items-center gap-2 rounded-full bg-ink/10 px-4 py-1.5 font-mono-label text-[11px] font-bold text-ink">
          <Icon name="heart" class="h-3.5 w-3.5" /> Ponto de partida
        </span>
        <p class="reveal mt-6 font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl" style="transition-delay: 100ms">
          Toda seleção campeã nasceu numa quadra pequena, com um técnico que acreditou primeiro.
        </p>
        <p class="reveal mx-auto mt-5 max-w-xl leading-relaxed text-ink/90" style="transition-delay: 180ms">
          Esta é a nossa quadra pequena. {anos} anos recebendo do voleibol — agora é a nossa vez de
          retribuir, exatamente de onde tudo começou: a quadra do bairro.
        </p>
      </div>
    </section>

    <!-- FATOS RAPIDOS -->
    <section class="bg-paper py-20">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
          {fatos.map((f, i) => (
            <div class="reveal rounded-2xl border border-ink/8 bg-white p-6 shadow-card" style={`transition-delay: ${i * 70}ms`}>
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-soft text-brand-deep">
                <Icon name={f.icon} class="h-4.5 w-4.5" />
              </div>
              <p class="mt-4 font-mono-label text-[10px] font-bold text-ink-soft">{f.label}</p>
              <p class="mt-1 font-display text-2xl font-extrabold text-ink sm:text-3xl">{f.valor}</p>
              <p class="mt-0.5 text-xs text-ink-soft">{f.detalhe}</p>
            </div>
          ))}
        </div>
        <p class="reveal mt-6 text-center text-sm text-ink-soft" style="transition-delay: 280ms">
          Festival de Abertura em agosto/2026 · vagas por seleção técnica, disciplinar e social
        </p>
      </div>
    </section>

    <!-- POR QUE AGORA -->
    <section class="relative overflow-hidden bg-ink py-24">
      <div class="hatch-mark pointer-events-none absolute -right-16 bottom-0 h-64 w-64 rotate-12 text-brand/20"></div>
      <div class="relative mx-auto max-w-4xl px-5 text-center sm:px-8">
        <SectionTag text="Por que agora" />
        <h2 class="reveal mt-4 font-display text-3xl font-extrabold leading-tight text-white sm:text-4xl">
          Enquanto o topo da pirâmide balança, a base está vazia.
        </h2>
        <p class="reveal mx-auto mt-5 max-w-2xl leading-relaxed text-paper/70" style="transition-delay: 100ms">
          Em 2026, a seleção masculina foi eliminada da fase final da Liga das Nações — o ápice do que
          já é apontado como a maior crise do vôlei brasileiro no século. A base masculina não sobe ao
          pódio mundial desde 2011. Especialistas apontam a falta de estrutura de base como causa raiz
          — não a seleção principal.
        </p>
      </div>

      <div class="relative mx-auto mt-14 grid max-w-5xl gap-5 px-5 sm:grid-cols-2 sm:px-8 lg:grid-cols-4">
        {riscos.map((r, i) => (
          <div class="reveal rounded-2xl border border-white/10 bg-white/5 p-6" style={`transition-delay: ${i * 80}ms`}>
            <p class="font-display text-3xl font-extrabold text-brand">{r.valor}</p>
            <p class="mt-2 text-sm leading-relaxed text-paper/70">{r.texto}</p>
          </div>
        ))}
      </div>

      <div class="relative mx-auto mt-12 max-w-2xl px-5 text-center sm:px-8">
        <p class="reveal font-display text-xl font-bold leading-snug text-white sm:text-2xl">
          Formar atleta de verdade também é tirar essa criança da tela, do sofá e da ansiedade — antes
          que ela seja atleta.
        </p>
        <p class="reveal mt-6 text-xs text-paper/40" style="transition-delay: 100ms">
          Fontes: Lance!, O Tempo, Web Vôlei, Forbes Brasil · UNESP, SciELO, Archives of Health ·
          Ministério da Saúde/APM, Atlas Mundial da Obesidade 2026, SBP, OMS
        </p>
      </div>
    </section>

    <!-- LIDERANCA -->
    <section class="bg-paper-dim py-24">
      <div class="mx-auto max-w-5xl px-5 sm:px-8">
        <div class="reveal max-w-2xl">
          <SectionTag text="Quem lidera" />
          <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
            Duas trajetórias, uma missão
          </h2>
          <p class="mt-5 leading-relaxed text-ink-soft">
            Nomes que atravessaram décadas de alto rendimento no vôlei nacional e internacional — e que
            hoje escolheram voltar para investir na base de Joinville.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          <div class="reveal rounded-2xl bg-white p-7 shadow-card">
            <img
              src={ricardoImg.src ?? ricardoImg}
              alt="Ricardo Perini de Aviz"
              class="aspect-[4/5] w-32 rounded-xl object-cover shadow-lift sm:w-36"
            />
            <p class="mt-5 font-display text-xl font-bold text-ink">Ricardo Perini de Aviz</p>
            <p class="mt-1 font-mono-label text-[10px] font-bold text-brand-deep">
              Vice-Presidente · Coordenador de Vôlei de Base
            </p>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">
              Ex-atleta profissional, encerrou a carreira em 2024 e retornou a Joinville. Vice-campeão
              do Mundial Sub-19, campeão brasileiro de base, bicampeão catarinense e títulos nas ligas
              de Israel e Portugal — liga, copa e supercopa. Hoje lidera a aproximação do projeto com as
              escolas da região.
            </p>
          </div>
          <div class="reveal rounded-2xl bg-white p-7 shadow-card" style="transition-delay: 100ms">
            <img
              src={eduardoImg.src ?? eduardoImg}
              alt="Eduardo Perini de Aviz"
              class="aspect-[4/5] w-32 rounded-xl object-cover shadow-lift sm:w-36"
            />
            <p class="mt-5 font-display text-xl font-bold text-ink">Eduardo Perini de Aviz</p>
            <p class="mt-1 font-mono-label text-[10px] font-bold text-brand-deep">
              Presidente Mannerriege · Preparação física
            </p>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">
              Formado nas categorias de base do voleibol de Joinville, foi bicampeão da Superliga
              atuando ao lado de Bruninho e companhia. Hoje é preparador físico do Joinville Vôlei e
              está à frente da estruturação técnica e física do projeto.
            </p>
          </div>
        </div>

        <p class="reveal mt-6 text-xs text-ink-soft/60" style="transition-delay: 150ms">
          Fontes: site oficial Mannerriege, Joinville Vôlei, Volleybox, OGol, NSC Total (2025–2026)
        </p>

        <div class="reveal mt-8" style="transition-delay: 180ms">
          <CtaButton href="/transparencia#diretoria" variant="outline-dark">Conheça a diretoria</CtaButton>
        </div>
      </div>
    </section>

    <!-- CRONOGRAMA FASE 1 -->
    <section class="bg-paper py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="reveal flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-xl">
            <SectionTag text="Cronograma · Fase 1" />
            <h2 class="mt-4 font-display text-4xl font-extrabold text-ink sm:text-5xl">
              Rumo a dezembro de 2026
            </h2>
          </div>
          <div class="hidden gap-2 sm:flex">
            <button class="js-trophy-prev flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Anterior">
              <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
            </button>
            <button class="js-trophy-next flex h-10 w-10 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:bg-ink hover:text-white" aria-label="Próximo">
              <Icon name="arrow-right" class="h-4 w-4" />
            </button>
          </div>
        </div>

        <div class="js-trophy-track trophy-track reveal mt-10 flex gap-5 overflow-x-auto pb-4" style="transition-delay: 100ms">
          {cronograma.map((c, i) => (
            <div class="flex w-72 flex-shrink-0 flex-col rounded-2xl border border-ink/8 bg-white p-7 shadow-card sm:w-80">
              <span class="font-mono-label text-[11px] font-bold text-brand">{c.periodo}</span>
              <p class="mt-3 font-display text-xl font-bold text-ink">{c.titulo}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{c.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- VALORES -->
    <section class="bg-ink py-20">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
        <SectionTag text="O que formamos" />
        <h2 class="reveal mt-4 font-display text-3xl font-extrabold text-white sm:text-4xl">
          Atletas e cidadãos
        </h2>
        <div class="reveal mt-8 flex flex-wrap justify-center gap-2.5" style="transition-delay: 100ms">
          {valores.map((v) => (
            <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2 font-mono-label text-[11px] font-bold text-white/90">
              {v}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="bg-brand py-20">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
        <p class="reveal font-display text-3xl font-extrabold uppercase leading-tight text-white sm:text-5xl">
          Vôlei não se ensina em um dia.<br />Mas a decisão de começar, sim.
        </p>
        <p class="reveal mx-auto mt-5 max-w-xl leading-relaxed text-white/85" style="transition-delay: 100ms">
          Sua empresa pode apoiar o projeto, ou você pode indicar uma criança ou adolescente
          interessado em participar.
        </p>
        <div class="reveal mt-8 flex flex-wrap justify-center gap-4" style="transition-delay: 180ms">
          <CtaButton href="/apoie" variant="outline-light" magnetic>Ver cotas de patrocínio</CtaButton>
          <CtaButton href="/base/matricula" variant="outline-light" magnetic>Quero matricular</CtaButton>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
