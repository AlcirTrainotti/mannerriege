---
interface Props {
  href: string
  variant?: 'primary' | 'outline-light' | 'outline-dark' | 'ghost'
  magnetic?: boolean
  class?: string
}
const { href, variant = 'primary', magnetic = false, class: className = '' } = Astro.props as Props

const variants: Record<string, string> = {
  primary: 'bg-brand text-white hover:bg-brand-deep shadow-card',
  'outline-light': 'border border-white/70 text-white hover:bg-white hover:text-ink',
  'outline-dark': 'border border-ink/25 text-ink hover:border-ink hover:bg-ink hover:text-white',
  ghost: 'text-brand-deep hover:text-brand',
}
const cls = variants[variant] || variants.primary
---
<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 font-mono-label text-[11px] font-bold transition-all hover:-translate-y-0.5',
    cls,
    magnetic && 'magnetic js-magnetic',
    className,
  ]}
>
  <slot />
</a>
